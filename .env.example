# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# --- Supabase admin (required only for OAuth credential storage) ---
# Server-only. Never expose this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional) ---
# Any OpenAI-compatible endpoint. Without these, AI generation returns a
# deterministic demo plan and AI nodes use labelled simulation fallbacks.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Lovable AI Gateway / connector gateway (optional) ---
LOVABLE_API_KEY=

# --- Gmail / Google Sheets App User Connectors (optional) ---
GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=
GOOGLE_SHEETS_APP_USER_CONNECTOR_CLIENT_API_KEY=

# Base64-encoded 32-byte key used to encrypt per-user OAuth credentials.
APP_USER_CONNECTION_KEY_SECRET=
