# ---------------------------------------------------------------------------
# FlowMate AI — server environment
# Copy to `.env` and adjust. Never commit `.env` or real secrets.
# Both `npm run dev` and `npm start` load this file automatically when it
# exists (`--env-file-if-exists=.env`). Variables already exported in the
# shell take precedence.
# ---------------------------------------------------------------------------

# Runtime ---------------------------------------------------------------
# NODE_ENV=production
PORT=8790

# Public origin of the app (used for OAuth redirects back into the SPA and
# for same-origin checks). In production this must be the exact HTTPS origin,
# e.g. https://flowmate.example.com
APP_URL=http://localhost:5173

# Public origin of the API. Defaults to http://localhost:${PORT}.
# When the SPA and API share an origin this can stay unset.
# API_PUBLIC_URL=https://flowmate.example.com

# SQLite database file. Relative paths resolve from the process working dir.
# The directory is created automatically.
DATABASE_PATH=./data/flowmate.db

# Development demo login -------------------------------------------------
# The demo workspace is shared by everyone who uses this deployment.
# Disable it for a private production deployment.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@flowmate.ai
DEMO_PASSWORD=demo1234
DEMO_NAME=Demo User

# AI provider (OpenAI-compatible chat completions) ----------------------
# Leave AI_API_KEY empty to use the deterministic local demo planner.
# Keys are read only on the server and never sent to the browser.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
# When true, a failed/unconfigured provider falls back to the labelled local
# demo planner. Set false to make AI generation fail loudly instead.
AI_DEMO_FALLBACK=true

# Google OAuth (Gmail + Google Sheets) ----------------------------------
# Create an OAuth 2.0 Web application in Google Cloud Console.
# Redirect URI must match exactly:
#   ${API_PUBLIC_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://flowmate.example.com/api/integrations/google/callback

# Encryption key for OAuth tokens at rest (AES-256-GCM) -----------------
# Generate with: openssl rand -base64 48
# If unset, a built-in development key is used and the UI warns about it.
TOKEN_ENCRYPTION_KEY=

# Execution queue / scheduler -------------------------------------------
# The queue is in-process and SQLite-backed (development fallback).
# Jobs do not survive a restart; interrupted runs are marked failed.
QUEUE_POLL_MS=1200
SCHEDULER_POLL_MS=30000
# Per-step timeout and retry behaviour are fixed in server/engine/runner.ts:
# one retry for retryable provider errors and a 65-second timeout per step.

# Development client proxy ----------------------------------------------
# Only used by Vite dev server. The API server itself does not read this.
# VITE_API_TARGET=http://localhost:8790
